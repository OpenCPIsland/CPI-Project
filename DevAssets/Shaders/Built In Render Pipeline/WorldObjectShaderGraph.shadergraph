{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "079be154071340478c12104da2ddd191",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ShadowUVProjection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1001.9998779296875,
            "y": 337.0000305175781,
