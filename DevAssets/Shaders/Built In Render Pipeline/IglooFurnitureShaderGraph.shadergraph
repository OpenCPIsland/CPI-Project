    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\n    Direction = float3(0.5, 0.5, 0);\n    Color = float3(1, 1, 1);\n#else\n    // Directional light direction (already normalized for directional lights)\n    Direction = normalize(WorldPos);\n\n    // Light color\n    Color = _LightColor0.rgb;\n#endif"
}

