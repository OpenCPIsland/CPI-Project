    "m_Group": {
        "m_Id": "80f702db978f4128b606ef34953bcaf4"
    },
    "m_Name": "ShadowUVProjection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -502.9999084472656,
            "y": 1297.9998779296875,
