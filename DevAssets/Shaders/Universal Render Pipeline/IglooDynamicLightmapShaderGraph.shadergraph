{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7548d85c2a3b438e96f89db8b9f7a6e0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "DecodeVLDBiRP (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1239.0,
            "y": 176.99998474121095,
            "width": 246.99993896484376,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "9544caf5287047b3b97b55d03ea9068c"
        },
        {
            "m_Id": "79d6dbed4c8440eca67716a5a3e169c1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DecodeVLDBiRP",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\n    color = float3(1.0, 1.0, 1.0);\r\n#else\r\nfloat4 n = float4(worldNormal, 1.0);\t\t\t\t\r\n\r\nfloat3 shLinear;\r\nshLinear.x = dot(unity_SHAr, n);\r\nshLinear.y = dot(unity_SHAg, n);\r\nshLinear.z = dot(unity_SHAb, n);\r\n\r\nfloat4 shCross = worldNormal.xyzz * worldNormal.yzzx;\r\n\r\nfloat3 shQuadratic;\r\nshQuadratic.x = dot(unity_SHBr, shCross);\r\nshQuadratic.y = dot(unity_SHBg, shCross);\r\nshQuadratic.z = dot(unity_SHBb, shCross);\r\n\r\nfloat3 ambient = shLinear + shQuadratic + unity_SHC.xyz * ((worldNormal.x * worldNormal.x) - (worldNormal.y * worldNormal.y));\r\nambient = max(\r\n\t(1.055 * pow(ambient, 0.4166667)) - 0.055, \r\n\t0.0\r\n);\r\n\r\nfloat ndl = clamp((dot(float4(worldNormal, 0.0), _WorldSpaceLightPos0) + 1.0) / 4.0, 0.0, 1.0);\r\nfloat3 direct = _LightColor0.rgb * ndl;\r\n\r\ncolor = max(0.0, ambient) + direct;\r\n\t\t\t\t\r\n#endif"
}

