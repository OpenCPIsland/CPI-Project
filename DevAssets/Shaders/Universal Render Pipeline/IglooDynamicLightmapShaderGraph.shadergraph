{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "962e8494e1234886b33d630754b00a9f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "DecodeVLDURP (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1239.0001220703125,
            "y": 271.0000305175781,
            "width": 245.00006103515626,
            "height": 94.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c4520efde8d24f529ca33c8d0b8bb34d"
        },
        {
            "m_Id": "e692813b5ee74fb8821f4656061ed36a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DecodeVLDURP",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\n\r\n    color = float3(1.0, 1.0, 1.0);\r\n\r\n#else\r\n\r\nfloat4 n = float4(worldNormal, 1.0);\r\n\r\nfloat3 shLinear;\r\nshLinear.x = dot(unity_SHAr, n);\r\nshLinear.y = dot(unity_SHAg, n);\r\nshLinear.z = dot(unity_SHAb, n);\r\n\r\nfloat4 shCross = worldNormal.xyzz * worldNormal.yzzx;\r\n\r\nfloat3 shQuadratic;\r\nshQuadratic.x = dot(unity_SHBr, shCross);\r\nshQuadratic.y = dot(unity_SHBg, shCross);\r\nshQuadratic.z = dot(unity_SHBb, shCross);\r\n\r\nfloat3 ambient =\r\n    shLinear +\r\n    shQuadratic +\r\n    unity_SHC.xyz *\r\n    ((worldNormal.x * worldNormal.x) -\r\n     (worldNormal.y * worldNormal.y));\r\n\r\nambient = max(\r\n    (1.055 * pow(ambient, 0.4166667)) - 0.055,\r\n    0.0\r\n);\r\n\r\nfloat3 lightDirection = normalize(_MainLightPosition.xyz);\r\n\r\nfloat ndl = clamp(\r\n    (dot(float4(worldNormal, 0.0), float4(lightDirection, 0.0)) + 1.0) / 4.0,\r\n    0.0,\r\n    1.0\r\n);\r\n\r\nfloat3 direct = _MainLightColor.rgb * ndl;\r\n\r\ncolor = max(0.0, ambient) + direct;\r\n\r\n#endif"
}

